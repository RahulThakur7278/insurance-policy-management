# ========================
# Environment Configuration
# ========================

NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/insurance_db
MONGO_URI_TEST=mongodb://localhost:27017/insurance_db_test

# Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CPU Monitor
CPU_THRESHOLD=70
CPU_CHECK_INTERVAL_MS=5000

# Logging
LOG_LEVEL=info
LOG_DIR=logs
